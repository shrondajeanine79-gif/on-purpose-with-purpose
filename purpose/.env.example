# PURPOSE local environment example. Copy to .env only for local use. Never commit .env.
# Hive is disabled unless PURPOSE_ENABLE_HIVE=1 is set for a specific, owner-approved run.
PURPOSE_ENABLE_HIVE=0
HIVE_API_KEY=
